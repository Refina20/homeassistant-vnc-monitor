#!/command/with-contenv bashio
set -e

bashio::log.info 'Start multi-target noVNC dashboard'
export PYTHONPATH="/opt/vnc-viewer${PYTHONPATH:+:${PYTHONPATH}}"

printf '%s\n' 'window.VNC_VIEWER_LEGACY_TARGET = null;' > /noVNC/legacy-config.js
if bashio::config.has_value 'vnc_server_host'; then
    export VNC_VIEWER_LEGACY_HOST="$(bashio::config 'vnc_server_host')"
    export VNC_VIEWER_LEGACY_PORT="$(bashio::config 'vnc_server_port' '5900')"
    python3 -c 'import json, os; print("window.VNC_VIEWER_LEGACY_TARGET = " + json.dumps({"host": os.environ["VNC_VIEWER_LEGACY_HOST"], "port": int(os.environ["VNC_VIEWER_LEGACY_PORT"])}) + ";")' > /noVNC/legacy-config.js
fi

exec /usr/local/bin/websockify \
    --web /noVNC \
    --token-plugin dynamic_targets.DynamicTargets \
    --token-source dashboard \
    6080
